concept_humanity_mystery
<- sc_node_class;
<- class;
<- concept_wit_entity;

=> nrel_main_idtf:
    [тайна человечества]
    (* <- lang_ru;; *);

=> nrel_note:
    [объект, событие, явление или вопрос, связанный
    с историей и культурой человечества, для которого отсутствует
    общепринятое полное объяснение либо сохраняются существенные
    неизвестные обстоятельства]
    (* <- lang_ru;; *);;