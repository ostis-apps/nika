concept_archaeological_mystery
<- sc_node_class;
<- class;
<- concept_wit_entity;

=> nrel_main_idtf:
    [археологическая тайна]
    (* <- lang_ru;; *);

=> nrel_note:
    [тайна человечества, связанная
    с археологическим объектом, находкой или сооружением,
    происхождение, назначение или обстоятельства создания которого
    остаются не полностью установленными]
    (* <- lang_ru;; *);

<= nrel_inclusion:
    concept_humanity_mystery;;
