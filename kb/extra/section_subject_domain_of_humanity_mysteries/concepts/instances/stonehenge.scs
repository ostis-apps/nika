late_neolithic
<- concept_historical_period;

=> nrel_main_idtf:
    [поздний неолит]
    (* <- lang_ru;; *);

=> nrel_note:
    [Поздний неолит — исторический период, к которому относится
    один из основных этапов строительства Стоунхенджа.]
    (* <- lang_ru;; *);;


status_partially_explained
<- concept_explanation_status;

=> nrel_main_idtf:
    [частично объяснено]
    (* <- lang_ru;; *);

=> nrel_note:
    [Статус означает, что для исследуемой тайны существует
    научно обоснованная интерпретация, однако все обстоятельства
    и первоначальное назначение объекта не установлены однозначно.]
    (* <- lang_ru;; *);;