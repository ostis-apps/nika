stonehenge_mystery
<- concept_humanity_mystery;
<- concept_wit_entity;
<- concept_historical_mystery;
<- concept_archaeological_mystery;
<- concept_purpose_mystery;

=> nrel_main_idtf:
    [тайна назначения Стоунхенджа]
    (* <- lang_ru;; *);

=> nrel_note:
    [отсутствие однозначно установленного объяснения первоначального
    назначения этого доисторического сооружения]
    (* <- lang_ru;; *);

=> nrel_mystery_object:
    stonehenge;

