stonehenge
<- concept_mysterious_object;
<- concept_structure;
<- concept_wit_entity;

=> nrel_main_idtf:
    [Стоунхендж]
    (* <- lang_ru;; *);

=> nrel_note:
    [доисторический каменный памятник в Англии,
    формировавшийся в несколько этапов в эпоху неолита
    и бронзового века]
    (* <- lang_ru;; *);

=> nrel_studied_by_organization:
    english_heritage;

=> nrel_origin_period:
    late_neolithic;;


hypothesis_stonehenge_solar_ceremonial_use
<- concept_hypothesis;

=> nrel_main_idtf:
    [гипотеза о церемониальном назначении Стоунхенджа,
    связанном с солнечным циклом]
    (* <- lang_ru;; *);

=> nrel_note:
    [Гипотеза предполагает, что Стоунхендж использовался
    как церемониальное сооружение, связанное с движением Солнца
    и важными моментами календарного цикла.]
    (* <- lang_ru;; *);

=> nrel_supported_by_evidence:
    stonehenge_solstice_alignment;;


stonehenge_solstice_alignment
<- concept_evidence;

=> nrel_main_idtf:
    [ориентация Стоунхенджа относительно солнцестояний]
    (* <- lang_ru;; *);

=> nrel_note:
    [Расположение центральных камней Стоунхенджа связано
    с направлениями восхода и захода Солнца во время
    летнего и зимнего солнцестояний.]
    (* <- lang_ru;; *);;


english_heritage
<- concept_organization;

=> nrel_main_idtf:
    [English Heritage]
    (* <- lang_en;; *);

=> nrel_note:
    [English Heritage — организация, занимающаяся сохранением,
    изучением и представлением исторических объектов Англии,
    включая Стоунхендж.]
    (* <- lang_ru;; *);;


wiltshire
