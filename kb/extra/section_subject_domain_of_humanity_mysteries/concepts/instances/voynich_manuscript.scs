voynich_manuscript
<- concept_mysterious_object;
<- concept_artifact;
<- concept_document;
<- concept_wit_entity;

=> nrel_main_idtf:
    [Манускрипт Войнича]
    (* <- lang_ru;; *);

=> nrel_note:
    [иллюстрированная рукопись,
    известная также как Beinecke MS 408, текст которой
    остаётся нерасшифрованным]
    (* <- lang_ru;; *);

=> nrel_studied_by_organization:
    beinecke_library;

=> nrel_origin_period:
    fifteenth_century;

=> nrel_research_method:
    radiocarbon_dating;

=> nrel_research_result:
    voynich_parchment_dating_result;;


hypothesis_voynich_text_is_encoded
<- concept_hypothesis;

=> nrel_main_idtf:
    [гипотеза о зашифрованном характере текста Манускрипта Войнича]
    (* <- lang_ru;; *);

=> nrel_note:
    [Гипотеза предполагает, что неизвестный текст Манускрипта Войнича
    представляет собой закодированный или зашифрованный текст.
    Однозначного подтверждения этой версии нет.]
    (* <- lang_ru;; *);;


