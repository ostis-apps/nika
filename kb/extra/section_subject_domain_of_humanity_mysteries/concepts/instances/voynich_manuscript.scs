voynich_manuscript_mystery
<- concept_humanity_mystery;
<- concept_wit_entity;
<- concept_historical_mystery;
<- concept_cryptographic_mystery;

=> nrel_main_idtf:
    [тайна Манускрипта Войнича]
    (* <- lang_ru;; *);

=> nrel_note:
    [нерасшифрованный текст рукописи, написанный
    неизвестной системой письма]
    (* <- lang_ru;; *);

=> nrel_mystery_object:
    voynich_manuscript;

=> nrel_mystery_location:
